{
  "name": "@publicsquare/elements-js",
  "version": "2.0.1",
  "description": "PublicSquare JavaScript Elements",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/credova/elements.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun run clean && bun run --parallel build:bundle build:module build:package",
    "build:bundle": "rspack build",
    "build:module": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:package": "node prepare.js",
    "clean": "rimraf dist",
    "test": "bun test --isolate",
    "publish": "npm publish ./dist",
    "publish:beta": "npm publish ./dist --tag beta",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@basis-theory/basis-theory-js": "^4.30.0",
    "@basis-theory/web-threeds": "^2.1.2",
    "glob": "^13.0.6",
    "minimatch": "^10.2.5",
    "serialize-javascript": "^7.0.5",
    "follow-redirects": "^1.16.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "dotenv-webpack": "^9.0.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=10.12.0"
  }
}
