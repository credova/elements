{
  "name": "@publicsquare/elements-js",
  "version": "1.16.1",
  "description": "PublicSquare JavaScript Elements",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/credova/elements.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun run clean && concurrently \"bun run build:bundle\" \"bun run build:module\" \"bun run build:types\" \"bun run build:package\" -n \"bundle,module,types,package\" -c \"yellow,magenta,blue,green\" --kill-others-on-fail -g",
    "build:bundle": "webpack --config webpack.prod.js",
    "build:module": "babel src --extensions .ts --out-dir dist",
    "build:types": "tsc && tsc-alias",
    "build:package": "node prepare.js",
    "check": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "jest",
    "publish": "npm publish ./dist",
    "publish:beta": "npm publish ./dist --tag beta"
  },
  "dependencies": {
    "@basis-theory/basis-theory-js": "^4.30.0",
    "@basis-theory/web-threeds": "^2.1.2",
    "glob": "^13.0.6",
    "minimatch": "^10.2.5",
    "prettier": "^3.8.3",
    "serialize-javascript": "^7.0.5",
    "follow-redirects": "^1.16.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "axios": "^1.16.0",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "shell-quote": "^1.8.4",
    "fast-uri": "^3.1.2",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-arrow-functions": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.28.6",
    "@babel/template": "^7.28.6",
    "@babel/traverse": "^7.29.0",
    "@types/jest": "^30.0.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "babel-plugin-tsconfig-paths-module-resolver": "^1.0.4",
    "concurrently": "^9.0.1",
    "dotenv-webpack": "^9.0.0",
    "jest": "^30.0.4",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.5",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.6.2",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=10.12.0"
  }
}
