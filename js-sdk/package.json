{
  "name": "@publicsquare/elements-js",
  "version": "2.0.1",
  "description": "PublicSquare JavaScript Elements",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./types/sdk": {
      "types": "./dist/types/sdk/index.d.ts",
      "import": "./dist/esm/types/sdk/index.mjs",
      "require": "./dist/types/sdk/index.js"
    },
    "./googlePay/GooglePayButtonWidget": {
      "types": "./dist/googlePay/GooglePayButtonWidget.d.ts",
      "import": "./dist/esm/googlePay/GooglePayButtonWidget.mjs",
      "require": "./dist/googlePay/GooglePayButtonWidget.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/credova/elements.git"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "build:module": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:rslib": "rslib build",
    "build:package": "node prepare.js",
    "test": "bun test --isolate",
    "publish": "npm publish ./dist",
    "publish:beta": "npm publish ./dist --tag beta",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@basis-theory/basis-theory-js": "^4.30.0",
    "@basis-theory/web-threeds": "^2.1.2",
    "glob": "^13.0.6",
    "minimatch": "^10.2.5",
    "serialize-javascript": "^7.0.5",
    "follow-redirects": "^1.16.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  },
  "devDependencies": {
    "@rslib/core": "1.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
