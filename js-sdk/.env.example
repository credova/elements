# Basis Theory Public Application key (token:update permission only). This is the
# fixed PRODUCTION-branch key cards.updateCvc() uses — not merchant-configurable.
# Inlined into the built bundle at build time (dotenv-webpack for the UMD bundle,
# babel-plugin-inline-dotenv for the ES build) — never hardcode a real value in source.
PUBLICSQUARE_CVC_UPDATE_APP_KEY=key_prod_us_pub_your_key

# Same, but for the TEST branch (BT test tenant).
PUBLICSQUARE_CVC_UPDATE_TEST_APP_KEY=key_test_us_pub_your_key
