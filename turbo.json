{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "clean": {
      "cache": false
    },
    "build:module": {
      "dependsOn": ["clean", "^build"],
      "outputs": ["dist/**", "!dist/esm/**", "!dist/*.bundle.js*", "!dist/package.json", "!dist/README.md"]
    },
    "build:rslib": {
      "dependsOn": ["clean", "^build"],
      "outputs": ["dist/esm/**", "dist/*.bundle.js*"]
    },
    "build:package": {
      "dependsOn": ["clean"],
      "outputs": ["dist/package.json", "dist/README.md"]
    },
    "build": {
      "dependsOn": ["^build", "build:module", "build:rslib", "build:package"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
