{
  "name": "@publicsquare/elements-react",
  "version": "2.0.1",
  "description": "PublicSquare React Elements",
  "main": "dist/index.js",
  "module": "dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js"
    },
    "./types/sdk": {
      "types": "./dist/types/sdk.d.ts",
      "import": "./dist/esm/types/sdk.mjs",
      "require": "./dist/types/sdk.js"
    },
    "./elements/ApplePayButtonElement": {
      "types": "./dist/elements/ApplePayButtonElement.d.ts",
      "import": "./dist/esm/elements/ApplePayButtonElement.mjs",
      "require": "./dist/elements/ApplePayButtonElement.js"
    },
    "./elements/GooglePayButtonElement": {
      "types": "./dist/elements/GooglePayButtonElement.d.ts",
      "import": "./dist/esm/elements/GooglePayButtonElement.mjs",
      "require": "./dist/elements/GooglePayButtonElement.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/credova/elements.git"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "build:module": "tsc -p tsconfig.build.json",
    "build:rslib": "rslib build",
    "build:package": "node prepare.js",
    "publish": "npm publish ./dist",
    "publish:beta": "npm publish ./dist --tag beta",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@publicsquare/elements-js": "2.0.1",
    "glob": "^13.0.1",
    "minimatch": "^10.2.3",
    "follow-redirects": "^1.16.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  },
  "devDependencies": {
    "@rslib/core": "1.0.3",
    "@types/react": "^19.1.8",
    "react": "^19.2.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
