{
  "name": "@publicsquare/elements-react",
  "version": "2.0.1",
  "description": "PublicSquare React Elements",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/credova/elements.git"
  },
  "license": "MIT",
  "scripts": {
    "link:js-sdk": "cd ../js-sdk/dist && bun link && cd ../../react-sdk && bun link @publicsquare/elements-js",
    "build": "bun run clean && bun run --parallel build:module build:package",
    "build:module": "tsc -p tsconfig.build.json",
    "build:package": "node prepare.js",
    "clean": "rimraf dist",
    "publish": "npm publish ./dist",
    "publish:beta": "npm publish ./dist --tag beta",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@publicsquare/elements-js": "2.0.1",
    "glob": "^13.0.1",
    "minimatch": "^10.2.3",
    "follow-redirects": "^1.16.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "^19.2.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=10.12.0"
  }
}
