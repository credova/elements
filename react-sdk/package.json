{
  "name": "@publicsquare/elements-react",
  "version": "1.16.0",
  "description": "PublicSquare React Elements",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/credova/elements.git"
  },
  "license": "MIT",
  "scripts": {
    "link:js-sdk": "cd ../js-sdk/dist && bun link && cd ../../react-sdk && bun link @publicsquare/elements-js",
    "build": "bun run clean && concurrently \"bun run build:module\" \"bun run build:types\" \"bun run build:package\" --kill-others-on-fail",
    "build:module": "babel src --extensions .ts,.tsx --out-dir dist",
    "build:types": "tsc",
    "build:package": "node prepare.js",
    "clean": "rimraf dist",
    "test": "jest",
    "test:cov": "jest --coverage",
    "publish": "npm publish ./dist",
    "publish:beta": "npm publish ./dist --tag beta"
  },
  "dependencies": {
    "@publicsquare/elements-js": "1.16.0",
    "glob": "^13.0.1",
    "minimatch": "^10.2.3",
    "prettier": "^3.8.3",
    "follow-redirects": "^1.16.0"
  },
  "overrides": {
    "axios": "^1.16.0",
    "brace-expansion": "^5.0.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "shell-quote": "^1.8.4",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/react": "^19.1.8",
    "concurrently": "^9.0.1",
    "jest": "^30.0.4",
    "react": "^19.2.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=10.12.0"
  }
}
